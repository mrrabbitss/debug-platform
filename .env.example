# Core
APP_ENV=dev
DATABASE_URL=sqlite:///./data/gw_ap_debug.db
DATA_ROOT=./data
STORAGE_ROOT=./data/storage
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional API protection. Leave blank for local development.
API_KEY=
# local (loopback development), api_key (single shared key), or rbac (per-user tokens).
AUTH_MODE=local
# In rbac mode, allow API_KEY as an emergency ADMIN credential during migration.
AUTH_ALLOW_LEGACY_ADMIN=true

# Streamable HTTP MCP for Codex/Claude Code. Authentication always requires a
# Bearer credential: MCP_BEARER_TOKEN, an allowed API_KEY, or a personal token.
MCP_ENABLED=true
MCP_BEARER_TOKEN=
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*
MCP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*,http://[::1]:*
MCP_PUBLIC_BASE_URL=http://127.0.0.1:8000
MCP_MAX_REQUEST_BODY_BYTES=4194304

# LLM: mock or openai_compatible
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TEMPERATURE=0.1
# Single Chat request: 15 minutes. The old default 300 is upgraded to 900 at load.
# Other explicit values are preserved; durable AI jobs allow up to two hours.
LLM_TIMEOUT_SECONDS=900
LLM_MAX_RETRIES=2
# Comprehensive diagnosis keeps the 20-round exhaustive ceiling, but stops
# safely when one run reaches an aggregate budget or makes no new progress.
DIAGNOSTIC_AGENT_MAX_TOTAL_TOKENS=2000000
DIAGNOSTIC_AGENT_MAX_DURATION_SECONDS=10800
DIAGNOSTIC_AGENT_MAX_TOTAL_TOOL_CALLS=80
DIAGNOSTIC_AGENT_MAX_STAGNANT_ROUNDS=3
# Token-aware prompt admission. A model profile can override the first two
# values with config.context_window_tokens and config.context_reserved_output_tokens.
DIAGNOSTIC_CONTEXT_WINDOW_TOKENS=131072
DIAGNOSTIC_CONTEXT_RESERVED_OUTPUT_TOKENS=32768
DIAGNOSTIC_CONTEXT_SAFETY_MARGIN_TOKENS=2048
DIAGNOSTIC_CONTEXT_TARGET_OCCUPANCY=0.85
DIAGNOSTIC_CONTEXT_MAX_ITEM_TOKENS=10000
DIAGNOSTIC_CONTEXT_PREVIEW_TOKENS=768
DIAGNOSTIC_CONTEXT_SPILL_CHUNK_TOKENS=3000
# Optional Fernet key used to encrypt model API keys saved from the web UI.
# Leave blank for local use: the backend creates backend/data/model_secret.key automatically.
MODEL_SECRET_KEY=
# Comma-separated exact hosts or suffixes such as api.example.com,.corp.example.
# Required for loopback endpoints and for every API model endpoint in APP_ENV=prod.
# Development mode accepts both HTTP and HTTPS; HTTP alone does not require allowlisting.
MODEL_ENDPOINT_ALLOWLIST=
# Set true only when trusted private-network model hosts cannot be enumerated above.
# Loopback and link-local/metadata endpoints still require stricter checks.
# On a trusted company workstation, run scripts\enable_private_model_endpoints.bat
# once to persist true in the local Git-ignored .env file.
MODEL_ALLOW_PRIVATE_ENDPOINTS=false
# Source-only advanced compatibility switch. The portable launcher always
# overrides this to true so an old active local profile cannot load Torch.
MODEL_DISABLE_IN_PROCESS_LOCAL=false
# Weight downloads initiated from System Settings are stored outside the
# portable package. Override this only with an approved server-side directory.
# MODEL_DOWNLOAD_ROOT=D:\DebugPlatformModels
MODEL_DOWNLOAD_MIRRORS=https://hf-mirror.com,https://huggingface.co
MODEL_DOWNLOAD_MAX_FILES=1000
MODEL_DOWNLOAD_MAX_FILE_BYTES=12884901888
MODEL_DOWNLOAD_MAX_TOTAL_BYTES=21474836480
MODEL_DOWNLOAD_TIMEOUT_SECONDS=21600

# Qwen example (replace workspace ID, region and model according to your internal approval):
# LLM_PROVIDER=openai_compatible
# LLM_API_KEY=your-key
# LLM_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# GLM example: use the OpenAI-compatible Base URL supplied by the approved GLM service.
# LLM_PROVIDER=openai_compatible
# LLM_API_KEY=your-key
# LLM_BASE_URL=https://your-approved-glm-compatible-endpoint/v1
# LLM_MODEL=your-glm-model

MAX_UPLOAD_BYTES=2147483648
MAX_EXTRACTED_BYTES=8589934592
MAX_ARCHIVE_FILES=20000
PARSER_MAX_TEXT_BYTES=134217728
CURATION_MAX_FILES=500
CURATION_MAX_TOTAL_BYTES=536870912
CURATION_MAX_FILE_BYTES=134217728
CURATION_MAX_PROMPT_CHARS=120000
CURATION_MAX_DRAFT_CHARS=500000
CURATION_MAX_EXTRACTED_TEXT_CHARS=4000000
CURATION_MAX_DOCUMENT_UNCOMPRESSED_BYTES=268435456
CURATION_PDF_MAX_PAGES=500
CURATION_PDF_MAX_CONTENT_STREAM_BYTES=67108864
TOOL_TIMEOUT_SECONDS=300

# Optional Qdrant. If empty, the local hybrid retriever is used.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=gw_ap_knowledge

# Docker Compose local stack. Use a URL-safe password or override DOCKER_DATABASE_URL.
POSTGRES_USER=gwap
POSTGRES_PASSWORD=gwap-local-only
POSTGRES_DB=gwap
DOCKER_DATABASE_URL=postgresql+psycopg://gwap:gwap-local-only@postgres:5432/gwap
DOCKER_QDRANT_URL=http://qdrant:6333
BACKEND_PORT=8000
FRONTEND_PORT=8080

# The Win11 portable launcher sets STATIC_FRONTEND_ROOT, DATA_ROOT and
# DATABASE_URL to explicit package/AppData paths at runtime. Source development
# should leave STATIC_FRONTEND_ROOT unset so Vite serves the UI.
